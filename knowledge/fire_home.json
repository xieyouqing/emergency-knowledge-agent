  "triage": {
    "question": "着火的是你自己屋里，还是门外、楼道或楼下？",
    "options": [
      {
        "value": "outside",
        "label": "门外 / 楼道 / 楼下",
        "override": {
          "immediate": [
            {
              "text": "门发烫就别开门",
              "tool": null
            },
            {
              "text": "用湿被褥堵住门缝",
              "tool": null
            },
            {
              "text": "泼水给门降温",
              "tool": null
            },
            {
              "text": "到窗口挥衣物求救",
              "tool": null
            },
            {
              "text": "在窗口打 119 说清地址",
              "tool": {
                "name": "dial",
                "number": "119"
              }
            }
          ]
        }
      },
      {
        "value": "own_room",
        "label": "自己屋里起火",
        "override": null
      }
    ]
  },
  "steps": {
    "immediate": [
      {
        "text": "大声喊人，马上离开屋子",
        "tool": null
      },
      {
        "text": "贴近地面爬行，别站着跑",
        "tool": null
      },
      {
        "text": "用湿毛巾捂住口鼻",
        "tool": null
      },
      {
        "text": "走安全出口，不要坐电梯",
        "tool": null
      }
    ],
    "next": [
      {
        "text": "到室外安全处拨打 119",
        "tool": {
          "name": "dial",
          "number": "119"
        }
      },
      {
        "text": "门已发烫就别开门，堵门缝",
        "tool": null
      },
      {
        "text": "退回室内泼水降温，等救援",
        "tool": null
      },
      {
        "text": "在窗口挥衣物、打手电求救",
        "tool": null
      }
    ],
    "never": [
      {
        "text": "不要盲目跳楼",
        "tool": null
      },
      {
        "text": "不要乘坐电梯逃生",
        "tool": null
      },
      {
        "text": "门把手烫手时不要开门",
        "tool": null
      },
      {
        "text": "不要为拿东西返回火场",
        "tool": null
      }
    ]
  },
  "emergency_number": "119",
  "source": {
    "name": "中华人民共和国应急管理部《社区消防安全知识常识》（火灾逃生自救常识第 4 条）",
    "url": "https://www.mem.gov.cn/kp/shaq/201904/t20190401_366005.shtml",
    "date": "2026-11-18",
    "quote": "穿过浓烟逃生时，要尽量使身体贴近地面，并用湿毛巾捂住口鼻。",
    "supplementary": [
      {
        "name": "同上（火灾逃生自救常识第 7 条）",
        "url": "https://www.mem.gov.cn/kp/shaq/201904/t20190401_366005.shtml",
        "date": "2026-11-21",
        "quote": "室外着火，门已发烫时，千万不要开门，以防大火窜入室内。要用浸湿的被褥、衣物等堵塞门窗，并泼水降温。",
        "supports": "分诊分支 outside 的 immediate[0..3]：门发烫不开门、堵门缝、泼水降温"
      },
      {
        "name": "同上（火灾逃生自救常识第 8 条）",
        "url": "https://www.mem.gov.cn/kp/shaq/201904/t20190401_366005.shtml",
        "date": "2026-11-21",
        "quote": "若所有逃生路线被大火封锁，要立即退回室内，用打手电筒、挥舞衣物、呼叫等方式向窗外发送求救信号，等待救援。",
        "supports": "分诊分支 outside 的 immediate[3..4]：窗口挥衣物求救；同时支撑 next[2] 退回室内等救援"
      }
    ]
  },
  "daily": {
    "summary": "火灾中最致命的是浓烟，不是火。贴近地面、捂住口鼻、走安全出口，不要坐电梯。",
    "why": "浓烟里有大量有毒气体，且热烟气聚集在上方，贴近地面空气相对干净，能见度也更好。电梯在火灾时会断电或成为烟囱通道，所以必须走安全出口。门已发烫说明门外火势很大，开门会让大火窜入室内。",
    "prevention": [
      "家里装独立式烟感报警器",
      "楼道和阳台不要堆放杂物",
      "提前认好两个方向的安全出口",
      "备一条湿毛巾放在易取处"
    ],
    "misconception": "躲进卫生间最安全——不一定，卫生间常无窗无法求救，且门多为塑料，遇高温会熔化。"
  },
