      },
      {
        "text": "往下压 5 到 6 厘米深",
        "tool": null
      },
      {
        "text": "每分钟压 100 到 120 次",
        "tool": null
      },
      {
        "text": "每压 30 次，吹 2 口气",
        "tool": null
      }
    ],
    "next": [
      {
        "text": "压完让胸口完全弹回来",
        "tool": null
      },
      {
        "text": "清掉嘴里的东西再吹气",
        "tool": null
      },
      {
        "text": "头后仰、抬下巴打开气道",
        "tool": null
      },
      {
        "text": "吹 1 秒，看胸口有没有起伏",
        "tool": null
      },
      {
        "text": "一直压到急救人员来接手",
        "tool": null
      }
    ],
    "never": [
      {
        "text": "别为用 AED 长时间停按压",
        "tool": null
      },
      {
        "text": "按压别中断，掌根别离胸",
        "tool": null
      },
      {
        "text": "吹气别太猛，会过度通气",
        "tool": null
