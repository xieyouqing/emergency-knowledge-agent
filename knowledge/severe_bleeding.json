  "life_threatening": true,
  "triage": {
    "question": "用手压住伤口，血能压住吗？",
    "options": [
      {
        "value": "cannot_stop",
        "label": "压不住 / 找不到哪出血",
        "override": {
          "immediate": [
            {
              "text": "压住伤口，扎上止血带",
              "tool": null
            },
            {
              "text": "马上打 120",
              "tool": {
