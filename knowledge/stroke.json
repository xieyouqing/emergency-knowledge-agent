  "steps": {
    "immediate": [
      {
        "text": "看脸歪不歪",
        "tool": null
      },
      {
        "text": "两支胳膊平举看有没力",
        "tool": null
      },
      {
        "text": "听说话清不清",
        "tool": null
      },
      {
        "text": "立刻打 120",
        "tool": {
          "name": "dial",
          "number": "120"
        }
      },
      {
        "text": "别自己开车去医院",
        "tool": null
      }
    ],
    "next": [
      {
        "text": "让他平躺，头稍抬高",
        "tool": null
      },
      {
        "text": "昏迷或呕吐就侧卧",
        "tool": null
      },
      {
        "text": "不要喂水喂食",
        "tool": null
      },
      {
        "text": "记下发病时间",
        "tool": null
      }
    ],
    "never": [
      {
        "text": "别自行服药",
        "tool": null
      },
      {
        "text": "别等它自己好",
        "tool": null
      },
      {
        "text": "别自己开车或让家人送",
        "tool": null
