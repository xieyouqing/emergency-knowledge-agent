{
  "schema_version": "1.0",
  "created_at": "2026-11-18",
  "purpose": "RAG 替换前后的固定对照组。同一份数据在 L1/L2/L3 三层各跑一次，差值即方案收益。",
  "docs": "docs/03-技术方案.md §6",
  "distribution": {
    "emergency": 40,
    "prevention": 30,
    "off_scope": 30,
    "total": 100
  },
  "field_spec": {
    "id": "唯一编号。E=紧急, P=预防咨询, O=含词无关",
    "text": "用户原话，口语化，不修饰",
    "group": "emergency | prevention | off_scope",
    "expect_intent": "ongoing | prevention | off_scope",
    "expect_scene": "命中的 slot id，或 null",
    "expect_action": "steps | dialonly | daily | refuse",
    "expect_action_note": "为什么是这个 action（用于人工复核标注是否正确）",
    "note": "可选。标出难例类型"
  },
  "action_semantics": {
    "steps": "场景已发布 → 出三段式步骤卡",
    "dialonly": "场景命中但未发布 → 只给拨号卡，不给步骤（不违反 S1）",
    "daily": "场景已发布 + 询问倾向 → 出 daily 四字段日常解释",
    "refuse": "库外或未收录 → 固定拒答话术 + 拨号"
  },
