# .env 的模板。真实值填在 .env（该文件不进版本库）。
# 复制一份改名 .env 后填入自己的值。
#
# 注意：DeepSeek 官方 key 格式是 sk- 开头（32 位十六进制）。
#      如果你拿到的 key 带 "deepseek" 前缀，那个前缀不属于 key 本身，要去掉。

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_PROXY_PORT=8787

# CORS 允许来源。**不填时默认 `*`**（任何网页都能调你的代理）。
# 本地开发因为只监听 127.0.0.1，外部访问不到，`*` 可接受。
# 一旦部署到公网（M3 云端中继），必须改成具体来源，否则等于把 key 借给别人用。
# LLM_PROXY_ORIGIN=http://localhost:8899

# ASR provider（默认 deepseek；讯飞需同时配 XFYUN_APPID / APIKEY / APISECRET）
# ASR_PROVIDER=xfyun
# XFYUN_APPID=
# XFYUN_APIKEY=
# XFYUN_APISECRET=
# XFYUN_ASR_HOST=iat.cn-huabei-1.xf-yun.com
# XFYUN_ASR_PATH=/v1
# XFYUN_ASR_DOMAIN=spark_asr_v2
