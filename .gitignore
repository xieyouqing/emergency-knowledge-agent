# ---- 依赖与构建产物 ----
node_modules/
dist/
build/
target/
src-tauri/target/
*.exe
*.msi
*.apk
*.aab

# ---- 运行日志（本地排查用，不进仓库） ----
# app/log.js → POST /log → logs/app-YYYY-MM-DD.log，保留 7 天
logs/

# ---- 测试音频样本（本地生成，不进仓库） ----
# e2e_asr.mjs 在缺样本时会用代理 /tts 现生成，仓库里不必存 272KB 二进制
tools/probe/audio/

# ---- 临时与备份文件 ----
# knowledge/ 下 _ 或 . 开头的文件为临时备份，校验脚本会跳过，不纳入版本控制
knowledge/_*
knowledge/.*
*.bak
*.tmp
*.log
~$*

# ---- 探测工具的大文件（25MB 下载测速用，本地生成，不进仓库） ----
# 重新生成：python -c "import os;open('tools/probe/dummy_25mb.bin','wb').write(os.urandom(25*1024*1024))"
tools/probe/dummy_25mb.bin

# ---- 离线小模型探针的模型文件（22.9MB，镜像下载，不进仓库） ----
# 重新获取见 tools/probe/intent_probe/RESULT.md §5
tools/probe/intent_probe/models/
tools/probe/intent_probe/.cache/
tools/probe/intent_probe/*.log

# ---- 编辑器与系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 密钥与环境变量 ----
# 严禁提交任何 API Key（云厂商 ASR/TTS 等）
.env
.env.*
!.env.example
*.key
secrets.json

# ---- 工具会话数据（本地工作记录，非项目资产） ----
# 需要团队共享的记录请另写进 docs/，此目录不进仓库
.workbuddy/
